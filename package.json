{
  "name": "react-example",
  "private": true,
  "workspaces": [
    "apps/e-learning",
    "apps/corporate-site"
  ],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:e-learning": "npm run dev --workspace technoedge-learning-studio -- --port=3002 --base=/e-learning/ --strictPort",
    "dev:website": "npm run dev --workspace technoedge-corporate-site -- --port=3003 --base=/website/ --strictPort",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build && npm run build:e-learning && npm run build:website",
    "build:e-learning": "node scripts/build-e-learning.mjs",
    "build:website": "node scripts/build-website.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "import:tools": "node scripts/import-tools-jsonl.mjs",
    "db:migrate": "node scripts/migrate-db.mjs",
    "db:import:tools": "node scripts/import-tools-db.mjs",
    "db:import:certifications": "node scripts/import-certifications-md.mjs",
    "db:import:certifications:xlsx": "node scripts/import-certifications-xlsx.mjs",
    "db:convert:technical": "node scripts/convert-technical-training-xlsx.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
